    {"id":"title","type":"text","x":280,"y":20,"width":540,"height":40,"angle":0,"strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"Transformer：从输入到下一个词元","fontSize":30,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","baseline":30,"seed":1,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"frameId":null,"boundElements":[],"updated":1,"link":null,"locked":false},
