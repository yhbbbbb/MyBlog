    {"id":"dec","type":"rectangle","x":90,"y":800,"width":920,"height":580,"angle":0,"strokeColor":"#6d28d9","backgroundColor":"#ede9fe","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":0,"opacity":100,"roundness":{"type":3},"seed":3,"version":1,"versionNonce":3,"isDeleted":false,"groupIds":[],"frameId":null,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"enc_text","type":"text","x":160,"y":105,"width":780,"height":620,"angle":0,"strokeColor":"#1e3a5f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"Encoder 编码器：理解输入句子\n\n源句词元（batch, seq_len）\n        ↓\nEmbedding + 位置编码\n(batch, seq_len, d_model)\n        ↓\n多头自注意力\nQ、K、V 都来自输入序列\n        ↓\nAdd & Norm：残差 + 归一化\n        ↓\nPosition-wise FFN\nLinear → ReLU → Linear\n        ↓\n编码器记忆：作为交叉注意力的 K / V","fontSize":22,"fontFamily":3,"textAlign":"center","verticalAlign":"top","baseline":22,"seed":4,"version":1,"versionNonce":4,"isDeleted":false,"groupIds":[],"frameId":null,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"dec_text","type":"text","x":160,"y":817,"width":780,"height":540,"angle":0,"strokeColor":"#6d28d9","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"text":"Decoder 解码器：逐步生成目标句子\n\n已生成目标词元（右移）\n        ↓\nMasked Multi-Head Attention\n只能看到当前位置及左侧前缀\n        ↓\nCross-Attention 交叉注意力\nQ 来自 Decoder，K/V 来自 Encoder\n        ↓\nFFN + Add & Norm\n输出每个位置的上下文表示\n        ↓\nLinear + Softmax\n下一个词元概率分布\n\n↗ 生成 token 后追加到目标前缀","fontSize":22,"fontFamily":3,"textAlign":"center","verticalAlign":"top","baseline":22,"seed":5,"version":1,"versionNonce":5,"isDeleted":false,"groupIds":[],"frameId":null,"boundElements":[],"updated":1,"link":null,"locked":false},
    {"id":"memory_arrow","type":"arrow","x":550,"y":738,"width":0,"height":118,"angle":0,"strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":3,"strokeStyle":"dashed","roughness":0,"opacity":100,"points":[[0,0],[0,118]],"startArrowhead":null,"endArrowhead":"arrow","seed":6,"version":1,"versionNonce":6,"isDeleted":false,"groupIds":[],"frameId":null,"boundElements":[],"updated":1,"link":null,"locked":false},
